{
    "name": "serenity_technologies/nowpayments",
    "description": "Laravel package for NOWPayments cryptocurrency payment processing API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kwadwo Kyeremeh",
            "email": "kyerematics@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "ext-json": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SerenityTechnologies\\NowPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SerenityTechnologies\\NowPayments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SerenityTechnologies\\NowPayments\\NowPaymentsServiceProvider"
            ],
            "aliases": {
                "NowPayments": "SerenityTechnologies\\NowPayments\\Facades\\NowPayments"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
